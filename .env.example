# ─────────────────────────────────────────────────────────────
# CONPAT CRM — Variables de Entorno (Ejemplo para Producción)
# ─────────────────────────────────────────────────────────────
# Copia este archivo, renómbralo a .env.local y completa los valores
# Para Vercel: agrega estas variables en el panel de Environment Variables
# ─────────────────────────────────────────────────────────────

# Entorno
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://tu-dominio.vercel.app

# ── Supabase ─────────────────────────────────────────────────
# Obtén estos valores desde: https://app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Auth ─────────────────────────────────────────────────────
# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET=genera-un-secreto-aleatorio-aqui
NEXTAUTH_URL=https://tu-dominio.vercel.app

# ── Storage ──────────────────────────────────────────────────
NEXT_PUBLIC_STORAGE_BUCKET=conpat-docs
